class Solution {
public:

    unordered_set<string> ans;

    void solve(string &s, int index, int left, int right,
               int removeLeft, int removeRight, string path) {

        if (index == s.size()) {
            if (left == right && removeLeft == 0 && removeRight == 0) {
                ans.insert(path);
            }
            return;
        }

        char ch = s[index];

        // Remove '('
        if (ch == '(' && removeLeft > 0) {
            solve(s, index + 1, left, right,
                  removeLeft - 1, removeRight, path);
        }

        // Remove ')'
        if (ch == ')' && removeRight > 0) {
            solve(s, index + 1, left, right,
                  removeLeft, removeRight - 1, path);
        }

        // Keep character
        if (ch != '(' && ch != ')') {
            solve(s, index + 1, left, right,
                  removeLeft, removeRight, path + ch);
        }

        // Keep '('
        else if (ch == '(') {
            solve(s, index + 1, left + 1, right,
                  removeLeft, removeRight, path + ch);
        }

        // Keep ')' only when valid
        else if (right < left) {
            solve(s, index + 1, left, right + 1,
                  removeLeft, removeRight, path + ch);
        }
    }

    vector<string> removeInvalidParentheses(string s) {

        int left = 0;
        int right = 0;

        for (char ch : s) {

            if (ch == '(') {
                left++;
            }
            else if (ch == ')') {

                if (left > 0) {
                    left--;
                }
                else {
                    right++;
                }
            }
        }

        solve(s, 0, 0, 0, left, right, "");

        return vector<string>(ans.begin(), ans.end());
    }
};
